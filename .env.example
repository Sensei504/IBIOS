# Optional frontend overrides. No .env file is required for local development.
# Never put DATABASE_URL, Redis URLs, passwords, or service tokens in frontend variables.
# By default, Vite proxies /api and /health to the local TypeScript backend at port 8000.
# Uncomment only when you want the browser to call a separate API origin directly.
# VITE_API_BASE=http://localhost:8000/api/v1
